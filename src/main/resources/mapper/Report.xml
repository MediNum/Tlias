<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itheima.mapper.ReportMapper">

    <!-- 员工性别统计 -->
    <select id="empGenderStatistics" resultType="java.util.Map">
        select count(*)                               as value,
               if(gender = 1, '男性员工', '女性员工') as name
        from emp
        group by gender;
    </select>

    <!-- 员工职位人数统计 -->
    <select id="empJobStatistics" resultType="java.util.Map">
        select d.name      as name,
               count(e.id) as count
        from dept d
                 left join emp e on e.dept_id = d.id
        group by d.id, d.name
    </select>
</mapper>